# Kora Agent Environment Configuration Template
KORA_APP_ENV=development
KORA_DEBUG=true

# Hugging Face Inference API
KORA_HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here
KORA_HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co

# Database & Redis
KORA_DATABASE_URL=postgresql+asyncpg://kora:kora_dev_password@localhost:5432/kora
KORA_REDIS_URL=redis://localhost:6379/0

# Google Workspace Integration (Phase 2)
# Required Enabled APIs in Google Cloud Console:
# 1. Gmail API (https://mail.google.com/)
# 2. Google Calendar API (https://www.googleapis.com/auth/calendar)
# 3. Google Drive API (https://www.googleapis.com/auth/drive)
# 4. Google Tasks API (https://www.googleapis.com/auth/tasks)
# 5. Google Docs API (https://docs.googleapis.com/)
# 6. Google Sheets API (https://sheets.googleapis.com/)
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8765/api/v1/auth/google/callback
GOOGLE_TOKEN_FILE=~/.kora/google_tokens.json
